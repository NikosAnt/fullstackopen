    "apollo-server": "^3.13.0",
    "apollo-server-core": "^3.13.0",
    "apollo-server-koa": "^3.13.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
